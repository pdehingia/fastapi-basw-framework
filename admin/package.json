{
  "name": "maya-admin-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:a11y": "eslint . --ext ts,tsx --config .eslintrc.json",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run --config vitest.config.ts src/**/*.a11y.test.tsx",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:a11y": "cypress run --spec 'cypress/e2e/**/*.a11y.cy.ts'",
    "accessibility:check": "node scripts/accessibility-check.js",
    "accessibility:test": "npm run test:a11y && npm run lint:a11y && npm run accessibility:check"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.0.18",
    "@hookform/resolvers": "^3.3.2",
    "@tanstack/react-query": "^5.8.4",
    "@tanstack/react-router": "^1.51.0",
    "@tanstack/react-table": "^8.10.7",
    "@tanstack/react-virtual": "^3.13.12",
    "@tanstack/router-devtools": "^1.136.1",
    "@tanstack/router-vite-plugin": "^1.136.1",
    "@types/react-window": "^1.8.8",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.16.5",
    "lucide-react": "^0.553.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.6.0",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "recharts": "^2.8.0",
    "tailwind-merge": "^2.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@axe-core/react": "^4.11.0",
    "@cypress/code-coverage": "^3.14.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.11.0",
    "cypress": "^15.6.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^8.53.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "happy-dom": "^20.0.10",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.2.0",
    "msw": "^2.12.2",
    "postcss": "^8.4.31",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.3.5",
    "terser": "^5.44.1",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^4.0.10",
    "vitest-axe": "^0.1.0"
  }
}
