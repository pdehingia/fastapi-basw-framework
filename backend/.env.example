# Maya Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit actual credentials to version control!

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME=Maya Platform
PROJECT_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
APP_URL=http://localhost:8000

# =============================================================================
# SECURITY KEYS (Generate secure random keys!)
# =============================================================================
SECRET_KEY=your-secret-key-here-min-32-chars-CHANGE-THIS
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars-CHANGE-THIS
API_KEY=your-api-key-here-CHANGE-THIS

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL (Port 5443 to avoid conflicts)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password-CHANGE-THIS
POSTGRES_DB=maya_platform
POSTGRES_PORT=5443
DATABASE_URL=postgresql://postgres:your-password@localhost:5443/maya_platform

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# MongoDB
MONGODB_SERVER=localhost
MONGODB_PORT=27017
MONGODB_URL=mongodb://username:password@localhost:27017/maya_platform_mongo?authSource=admin
MONGODB_DATABASE=maya_platform_mongo
MONGODB_USER=your-mongo-username-CHANGE-THIS
MONGODB_PASSWORD=your-mongo-password-CHANGE-THIS

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://:your-redis-password@localhost:6379/0
REDIS_PASSWORD=your-redis-password-CHANGE-THIS
CACHE_TTL=300
CACHE_ENABLED=true

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]
ENABLE_CORS=true
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
PASSWORD_MIN_LENGTH=8

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email Configuration
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-CHANGE-THIS
SMTP_SECURE=false
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Maya Platform

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=["jpg","jpeg","png","pdf","doc","docx"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# THIRD-PARTY API KEYS
# =============================================================================
# Google Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-CHANGE-THIS
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id-CHANGE-THIS
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret-CHANGE-THIS

# Payment Processing - Razorpay (India)
RAZORPAY_KEY_ID=your-razorpay-key-id-CHANGE-THIS
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-CHANGE-THIS

# Stripe (Optional - for international payments)
STRIPE_SECRET_KEY=your-stripe-secret-key-CHANGE-THIS
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-CHANGE-THIS
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-CHANGE-THIS

# Communication
TWILIO_ACCOUNT_SID=your-twilio-account-sid-CHANGE-THIS
TWILIO_AUTH_TOKEN=your-twilio-auth-token-CHANGE-THIS
TWILIO_PHONE_NUMBER=your-twilio-phone-number-CHANGE-THIS

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================
# Error Tracking
SENTRY_DSN=your-sentry-dsn-url-CHANGE-THIS

# Analytics
GOOGLE_ANALYTICS_ID=your-google-analytics-id-CHANGE-THIS

# =============================================================================
# DOCKER DATABASE ADMIN CREDENTIALS
# =============================================================================
# pgAdmin Access
PGADMIN_DEFAULT_EMAIL=admin@maya.com
PGADMIN_DEFAULT_PASSWORD=your-pgadmin-password-CHANGE-THIS

# MongoDB Express Access
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=your-mongo-express-password-CHANGE-THIS

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# These can be enabled in development environment
ENABLE_DOCS=true
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_METRICS=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
ENABLE_LOGGING=true
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/maya-platform.log
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_COUNT=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_USER_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_GEOLOCATION=true
ENABLE_REAL_TIME_CHAT=true
ENABLE_PUSH_NOTIFICATIONS=true

# =============================================================================
# RATE LIMITING
# =============================================================================
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200
RATE_LIMIT_STORAGE=redis

# =============================================================================
# CELERY (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://:your-redis-password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@localhost:6379/2

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-CHANGE-THIS
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-CHANGE-THIS
AWS_S3_BUCKET=your-s3-bucket-name-CHANGE-THIS
AWS_REGION=your-aws-region-CHANGE-THIS